# Salin menjadi .env lalu isi. Jangan commit .env.
# Domain HTTPS menuju IP VPS ini. Tanpa domain sendiri, pakai sslip.io (gratis, sertifikat sah):
#   IP 203.0.113.5  ->  LLM_DOMAIN=203-0-113-5.sslip.io
LLM_DOMAIN=
# Kunci akses (acak, panjang). Buat:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# atau:  openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
# Nilai yang sama dipasang di backend sebagai LLM_API_KEY.
LLM_API_KEY=
