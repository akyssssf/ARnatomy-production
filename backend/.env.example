# ARnatomy backend: salin menjadi .env lalu isi. Jangan commit berkas .env.

NODE_ENV=development
PORT=4000

# Basis data. Kosongkan untuk mode pengembangan tanpa instalasi (PGlite, disimpan di .data/pglite),
# atau isi dengan URL PostgreSQL:  postgres://arnatomy:arnatomy@localhost:5432/arnatomy
DATABASE_URL=

# Penandatangan JWT (HS256). WAJIB di produksi, minimal 32 karakter.
# Buat dengan:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
ACCESS_TTL_MENIT=15
REFRESH_TTL_HARI=7

# Asal klien yang diizinkan CORS, dipisah koma (contoh: https://arnatomy.vercel.app,http://localhost:3000)
CORS_ORIGINS=http://localhost:3000

# Login Google: Client ID (Web, Android, iOS) dipisah koma. Kosong = login Google dinonaktifkan.
GOOGLE_CLIENT_IDS=584791766054-bvjfe71qk42tduplhfl26s2bn29bqn5e.apps.googleusercontent.com

# Asisten AI (FR-08). Kosongkan LLM_API_KEY = jawaban dari basis pengetahuan lokal (tanpa AI).
# Penyedia gratis: gemini (Google AI Studio), groq, openrouter. Berbayar: anthropic, openai.
# LLM_MODEL dan LLM_BASE_URL opsional (bawaan menurut penyedia).
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# RAG asisten (data/rag): q8 = embedding ONNX terkuantisasi (±700 MB RAM), fp32 = lebih setia (±1,2 GB), off = TF-IDF saja
# (untuk VPS 1 GB). Model diunduh otomatis saat pertama jalan atau lewat: npm run rag:unduh-model
RAG_EMBEDDING=auto
RAG_CACHE_DIR=./.cache/hf
# Batas penolakan jarak embedding (bawaan 0.46 dari kontrak)
RAG_BATAS_JARAK=
# Cache jawaban asisten untuk pertanyaan identik (menit; 0 = nonaktif). Menghemat kuota LLM gratis.
ASISTEN_CACHE_MENIT=15

# Penyimpanan aset model 3D (FR-12): lokal (pengembangan) atau s3 (R2 / S3 / MinIO)
STORAGE_DRIVER=lokal
STORAGE_DIR=./uploads
# Dipakai driver s3:
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# URL dasar publik untuk membaca berkas (CDN atau domain bucket)
STORAGE_PUBLIC_URL=http://localhost:4000/files

# Isi data demo (akun siswa/guru/admin berkata sandi lemah) HANYA untuk pengembangan
SEED_DEMO=true
# Akun admin awal untuk produksi (dipakai bila SEED_DEMO=false)
ADMIN_EMAIL=
ADMIN_PASSWORD=
