{
  "name": "arnatomy-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend REST API ARnatomy (SKPL v1.0): Hono + PostgreSQL (Drizzle) + JWT + bcrypt",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "db:seed": "tsx src/db/seed-cli.ts",
    "uji-beban": "node scripts/uji-beban.mjs",
    "rag:unduh-model": "tsx scripts/unduh-model.ts",
    "rag:evaluasi": "tsx scripts/evaluasi-rag.ts",
    "llm:bandingkan": "tsx scripts/bandingkan-llm.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@hono/node-server": "^2.1.4",
    "@huggingface/transformers": "^4.3.1",
    "@node-rs/bcrypt": "^2.0.0",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.45.4",
    "google-auth-library": "^11.2.0",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "postgres": "^3.4.9",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
