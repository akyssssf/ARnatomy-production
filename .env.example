# Salin menjadi .env lalu isi. Jangan commit .env.
# Buat rahasia acak:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# Alamat publik situs (tanpa garis miring akhir). Dipakai CORS, metadata, dan ditanam saat build frontend.
# Produksi: SITE_URL=https://arnatomyuns.tifpsdku.com
SITE_URL=http://localhost:3000
PORT_HOST=3000

# Rahasia (WAJIB, minimal 32 karakter, berbeda satu sama lain)
JWT_SECRET=
SESSION_SECRET=
DB_PASSWORD=arnatomy

# Akun administrator awal (WAJIB; sandi minimal 8 karakter, huruf dan angka). Ganti setelah masuk.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Login Google: Client ID (Web). Kosong = tombol Google tidak muncul.
# Domain SITE_URL harus ada di Authorized JavaScript origins pada Google Cloud Console.
GOOGLE_CLIENT_ID=

# Asisten AI. Kosong = jawaban dari basis pengetahuan lokal tanpa LLM.
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=
# q8 (bawaan, ±700 MB RAM) | fp32 | off (TF-IDF saja, untuk server 1 GB)
RAG_EMBEDDING=q8

# Ubah ke false HANYA bila menguji lewat http biasa tanpa HTTPS
COOKIE_AMAN=true
